# Configuration du packager BigWigs (zip publié sur CurseForge).
# Le dossier de l'addon dans le zip :
package-as: HFForever

# Notes de version affichées sur CurseForge et dans la release GitHub.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Pas dans le zip publié : documentation de développement. Les fichiers qui
# commencent par un point (.git, .github, .pkgmeta) sont exclus d'office.
ignore:
  - docs
