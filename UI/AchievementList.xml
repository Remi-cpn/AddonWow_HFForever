<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!--
		Lignes de la liste des hauts faits (partie droite de la fenêtre).
		Clones de Blizzard_AchievementUI/Mainline/Blizzard_AchievementUI.xml
		(export Forever 1.60.1), renommés avec le préfixe HFF.
		Retiré : guilde (tabard, coins), suivi d'objectifs (case à cocher,
		le suivi Blizzard ne connaît pas nos hauts faits), noms globaux
		($parentXxx) remplacés par des parentKey.
		Pas d'attribut mixin : il demanderait une table globale. Les fonctions
		sont ajoutées par UI/AchievementList.lua.
	-->

	<!-- Icône du haut fait avec son cadre (clone de AchievementIconFrameTemplate). -->
	<Frame name="HFFAchievementIconFrameTemplate" virtual="true">
		<Layers>
			<Layer level="BORDER">
				<Texture parentKey="bling" file="Interface\AchievementFrame\UI-Achievement-Bling" hidden="true">
					<Size x="116" y="116"/>
					<Anchors>
						<Anchor point="CENTER" x="-1" y="1"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="texture">
					<Size x="50" y="50"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="3"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="frame" file="Interface\AchievementFrame\UI-Achievement-IconFrame">
					<Size x="72" y="72"/>
					<Anchors>
						<Anchor point="CENTER" x="-1" y="2"/>
					</Anchors>
					<TexCoords left="0" right="0.5625" top="0" bottom="0.5625"/>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

	<!-- Critère texte (clone de AchievementCriteriaTemplate). -->
	<Frame name="HFFAchievementCriteriaTemplate" virtual="true">
		<Size x="350" y="15"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Check" file="Interface\AchievementFrame\UI-Achievement-Criteria-Check">
					<Size x="20" y="16"/>
					<Anchors>
						<Anchor point="LEFT" x="0" y="-3"/>
					</Anchors>
					<TexCoords left="0" right="0.625" top="0" bottom="1"/>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Name" inherits="AchievementCriteriaFont">
					<Size x="0" y="15"/>
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Check" relativePoint="RIGHT" x="5" y="2"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<!-- Critère en barre de progression (clone de AchievementProgressBarTemplate). -->
	<StatusBar name="HFFAchievementProgressBarTemplate" virtual="true">
		<Size x="212" y="14"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="BG">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<Color r="0" g="0" b="0" a=".4"/>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Text" inherits="GameFontHighlightSmall" justifyV="TOP">
					<Size x="0" y="0"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="BorderLeft" file="Interface\AchievementFrame\UI-Achievement-ProgressBar-Border">
					<Size x="16" y="0"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="-6" y="5"/>
						<Anchor point="BOTTOMLEFT" x="-6" y="-5"/>
					</Anchors>
					<TexCoords left="0" right="0.0625" top="0" bottom="0.75"/>
				</Texture>
				<Texture parentKey="BorderRight" file="Interface\AchievementFrame\UI-Achievement-ProgressBar-Border">
					<Size x="16" y="0"/>
					<Anchors>
						<Anchor point="TOPRIGHT" x="6" y="5"/>
						<Anchor point="BOTTOMRIGHT" x="6" y="-5"/>
					</Anchors>
					<TexCoords left="0.812" right="0.8745" top="0" bottom="0.75"/>
				</Texture>
				<Texture parentKey="BorderCenter" file="Interface\AchievementFrame\UI-Achievement-ProgressBar-Border">
					<Size x="16"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.BorderLeft" relativePoint="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.BorderRight" relativePoint="BOTTOMLEFT"/>
					</Anchors>
					<TexCoords left="0.0625" right="0.812" top="0" bottom="0.75"/>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				self:SetStatusBarColor(0, .6, 0, 1);
				self:SetMinMaxValues(0, 100);
				self:SetValue(0);
				self:GetStatusBarTexture():SetDrawLayer("BORDER");
			</OnLoad>
		</Scripts>
		<BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
	</StatusBar>

	<!-- Petite icône d'un haut fait de la série (clone de MiniAchievementTemplate).
	     Infobulle ajoutée par UI/AchievementList.lua. -->
	<Frame name="HFFMiniAchievementTemplate" virtual="true">
		<Size x="42" y="42"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Icon">
					<Anchors>
						<Anchor point="TOPLEFT" x="8" y="-8"/>
						<Anchor point="BOTTOMRIGHT" x="-8" y="8"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture parentKey="Border" file="Interface\AchievementFrame\UI-Achievement-Progressive-IconBorder">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<TexCoords left="0" right="0.65625" top="0" bottom="0.65625"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Shield" file="Interface\AchievementFrame\UI-Achievement-Progressive-Shield">
					<Anchors>
						<Anchor point="TOPLEFT" x="12" y="-12"/>
						<Anchor point="BOTTOMRIGHT" x="16" y="-16"/>
					</Anchors>
					<TexCoords left="0" right="0.75" top="0" bottom="0.75"/>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Points" inherits="GameFontWhiteSmall" justifyV="BOTTOM">
					<Size x="18" y="18"/>
					<Anchors>
						<Anchor point="BOTTOMRIGHT" x="-2" y="3"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<!-- Critère « obtenir un autre haut fait » d'un méta (clone de MetaCriteriaTemplate).
	     Clic et infobulle ajoutés par UI/AchievementList.lua. -->
	<Button name="HFFMetaCriteriaTemplate" virtual="true">
		<Size x="155" y="30"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Icon">
					<Size x="17" y="17"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="6" y="-6"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture parentKey="Border" file="Interface\AchievementFrame\UI-Achievement-Progressive-IconBorder">
					<Size x="30" y="30"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
					<TexCoords left="0" right="0.65625" top="0" bottom="0.65625"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Check" file="Interface\AchievementFrame\UI-Achievement-Criteria-Check">
					<Size x="20" y="16"/>
					<Anchors>
						<Anchor point="RIGHT" relativePoint="LEFT" x="0" y="0"/>
					</Anchors>
					<TexCoords left="0" right="0.65625" top="0" bottom="1"/>
				</Texture>
				<FontString parentKey="Label" inherits="AchievementCriteriaFont">
					<Size x="125" y="20"/>
					<Anchors>
						<Anchor point="LEFT" relativePoint="LEFT" x="34" y="2"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<HighlightTexture file="Interface\FriendsFrame\UI-FriendsFrame-HighlightBar" alphaMode="ADD">
			<Anchors>
				<Anchor point="TOPLEFT"/>
				<Anchor point="BOTTOMRIGHT" x="0" y="2"/>
			</Anchors>
			<Color r="1" g="1" b="1" a=".15"/>
		</HighlightTexture>
	</Button>

	<!-- Une ligne de la liste (clone de AchievementTemplate).
	     EventButton comme chez Blizzard, et pas Button : il signale ses
	     changements de taille, ce qui permet à la liste de décaler les lignes
	     suivantes quand celle-ci se déplie (ScrollUtil.AddResizableChildrenBehavior). -->
	<EventButton name="HFFAchievementTemplate" inherits="TooltipBorderBackdropTemplate" virtual="true">
		<Size x="434" y="142"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" file="Interface\AchievementFrame\UI-Achievement-Parchment-Horizontal">
					<Anchors>
						<Anchor point="TOPLEFT" x="3" y="-3"/>
						<Anchor point="BOTTOMRIGHT" x="-3" y="3"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture parentKey="BottomLeftTsunami" file="Interface\AchievementFrame\UI-Achievement-Tsunami-Corners">
					<Size x="32" y="32"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="-2" y="-2"/>
					</Anchors>
					<Color r="1" g="1" b="1" a=".2"/>
					<TexCoords left="0" right=".5" top="0" bottom="1"/>
				</Texture>
				<Texture parentKey="BottomRightTsunami" file="Interface\AchievementFrame\UI-Achievement-Tsunami-Corners">
					<Size x="32" y="32"/>
					<Anchors>
						<Anchor point="BOTTOMRIGHT" x="2" y="-2"/>
					</Anchors>
					<Color r="1" g="1" b="1" a=".2"/>
					<TexCoords left=".5" right="1" top="0" bottom="1"/>
				</Texture>
				<Texture parentKey="TopLeftTsunami" file="Interface\AchievementFrame\UI-Achievement-Tsunami-Corners">
					<Size x="32" y="32"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="-2" y="-20"/>
					</Anchors>
					<Color r="1" g="1" b="1" a=".1"/>
					<TexCoords left="1" right=".5" top="1" bottom="0"/>
				</Texture>
				<Texture parentKey="TopRightTsunami" file="Interface\AchievementFrame\UI-Achievement-Tsunami-Corners">
					<Size x="32" y="32"/>
					<Anchors>
						<Anchor point="TOPRIGHT" x="2" y="-20"/>
					</Anchors>
					<Color r="1" g="1" b="1" a=".1"/>
					<TexCoords left=".5" right="0" top="1" bottom="0"/>
				</Texture>
				<Texture parentKey="BottomTsunami1" file="Interface\AchievementFrame\UI-Achievement-Borders">
					<Size x="370" y="16"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" relativeKey="$parent.BottomLeftTsunami" relativePoint="BOTTOMRIGHT" x="0" y="3"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomRightTsunami" relativePoint="BOTTOMLEFT"/>
					</Anchors>
					<Color r="1" g="1" b="1" a=".35"/>
					<TexCoords left="0" right="0.72265" top="0.51953125" bottom="0.58203125"/>
				</Texture>
				<Texture parentKey="TopTsunami1" file="Interface\AchievementFrame\UI-Achievement-Borders">
					<Size x="370" y="16"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.TopLeftTsunami" relativePoint="TOPRIGHT" x="0" y="-3"/>
						<Anchor point="TOPRIGHT" relativeKey="$parent.TopRightTsunami" relativePoint="TOPLEFT"/>
					</Anchors>
					<Color r="1" g="1" b="1" a="0.3"/>
					<TexCoords left="0.72265" right="0" top="0.58203125" bottom="0.51953125"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="TitleBar" file="Interface\AchievementFrame\UI-Achievement-Borders">
					<Size x="0" y="24"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="5" y="-4"/>
						<Anchor point="TOPRIGHT" x="-5" y="-4"/>
					</Anchors>
					<TexCoords left="0" right="0.9765625" top="0.66015625" bottom="0.73828125"/>
					<Color r="1" g="1" b="1" a=".8"/>
				</Texture>
				<Texture parentKey="Glow" file="Interface\AchievementFrame\UI-Achievement-Borders">
					<Size x="10" y="64"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.TitleBar" relativePoint="BOTTOMLEFT" x="0" y="4"/>
						<Anchor point="RIGHT" x="0" y="4"/>
					</Anchors>
					<TexCoords left="0" right="1" top="0.00390625" bottom="0.25390625"/>
				</Texture>
				<Texture parentKey="RewardBackground" file="Interface\AchievementFrame\UI-Achievement-Reward-Background" hidden="true">
					<Size x="384" y="24"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="5" y="-2"/>
						<Anchor point="BOTTOMRIGHT" x="-5" y="5"/>
					</Anchors>
					<TexCoords left="0" right=".69" top="0" bottom=".75"/>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Label" inherits="GameFontHighlightMedium">
					<Size x="320" y="20"/>
					<Anchors>
						<Anchor point="TOP" relativeKey="$parent.TitleBar" relativePoint="TOP" x="0" y="0"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Reward" inherits="GameFontNormalSmall" hidden="true">
					<Size x="355" y="20"/>
					<Anchors>
						<Anchor point="TOP" relativeKey="$parent.RewardBackground" relativePoint="TOP" x="0" y="1"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Description" inherits="AchievementDescriptionFont">
					<Size x="0" y="0"/>
					<Anchors>
						<Anchor point="TOP" x="0" y="-30"/>
					</Anchors>
				</FontString>
				<FontString parentKey="HiddenDescription" inherits="AchievementDescriptionFont" hidden="true">
					<Size x="0" y="0"/>
					<Anchors>
						<Anchor point="TOP" x="0" y="-30"/>
					</Anchors>
				</FontString>
				<Texture parentKey="PlusMinus" file="Interface\AchievementFrame\UI-Achievement-PlusMinus" hidden="true">
					<Size x="15" y="15"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="72" y="-9"/>
					</Anchors>
					<TexCoords left="0" right=".5" top="0" bottom=".25"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<!-- Contour lumineux au survol et quand la ligne est sélectionnée. -->
			<Frame parentKey="Highlight" setAllPoints="true" hidden="true" enableMouse="false">
				<Layers>
					<Layer level="OVERLAY">
						<Texture parentKey="TopLeft" file="Interface\PaperDollInfoFrame\UI-Character-ReputationBar-Highlight" alphaMode="ADD">
							<Size x="16" y="16"/>
							<Anchors>
								<Anchor point="TOPLEFT" x="-1" y="2"/>
							</Anchors>
							<TexCoords left="0.06640625" right="0" top="0.4375" bottom="0.65625"/>
						</Texture>
						<Texture parentKey="BottomLeft" file="Interface\PaperDollInfoFrame\UI-Character-ReputationBar-Highlight" alphaMode="ADD">
							<Size x="16" y="16"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="-1" y="-2"/>
							</Anchors>
							<TexCoords left="0.06640625" right="0" top="0.65625" bottom="0.4375"/>
						</Texture>
						<Texture parentKey="TopRight" file="Interface\PaperDollInfoFrame\UI-Character-ReputationBar-Highlight" alphaMode="ADD">
							<Size x="16" y="16"/>
							<Anchors>
								<Anchor point="TOPRIGHT" x="1" y="2"/>
							</Anchors>
							<TexCoords left="0" right="0.06640625" top="0.4375" bottom="0.65625"/>
						</Texture>
						<Texture parentKey="BottomRight" file="Interface\PaperDollInfoFrame\UI-Character-ReputationBar-Highlight" alphaMode="ADD">
							<Size x="16" y="16"/>
							<Anchors>
								<Anchor point="BOTTOMRIGHT" x="1" y="-2"/>
							</Anchors>
							<TexCoords left="0" right="0.06640625" top="0.65625" bottom="0.4375"/>
						</Texture>
						<Texture parentKey="Top" file="Interface\PaperDollInfoFrame\UI-Character-ReputationBar-Highlight" alphaMode="ADD">
							<Anchors>
								<Anchor point="TOPLEFT" relativeKey="$parent.TopLeft" relativePoint="TOPRIGHT"/>
								<Anchor point="BOTTOMRIGHT" relativeKey="$parent.TopRight" relativePoint="BOTTOMLEFT"/>
							</Anchors>
							<TexCoords left="0" right="0.015" top="0.4375" bottom="0.65625"/>
						</Texture>
						<Texture parentKey="Bottom" file="Interface\PaperDollInfoFrame\UI-Character-ReputationBar-Highlight" alphaMode="ADD">
							<Anchors>
								<Anchor point="TOPLEFT" relativeKey="$parent.BottomLeft" relativePoint="TOPRIGHT"/>
								<Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomRight" relativePoint="BOTTOMLEFT"/>
							</Anchors>
							<TexCoords left="0" right="0.015" top="0.65625" bottom="0.4375"/>
						</Texture>
						<Texture parentKey="Left" file="Interface\PaperDollInfoFrame\UI-Character-ReputationBar-Highlight" alphaMode="ADD">
							<Anchors>
								<Anchor point="TOPLEFT" relativeKey="$parent.TopLeft" relativePoint="BOTTOMLEFT"/>
								<Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomLeft" relativePoint="TOPRIGHT"/>
							</Anchors>
							<TexCoords left="0.06640625" right="0" top="0.65625" bottom="0.6"/>
						</Texture>
						<Texture parentKey="Right" file="Interface\PaperDollInfoFrame\UI-Character-ReputationBar-Highlight" alphaMode="ADD">
							<Anchors>
								<Anchor point="TOPLEFT" relativeKey="$parent.TopRight" relativePoint="BOTTOMLEFT"/>
								<Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomRight" relativePoint="TOPRIGHT"/>
							</Anchors>
							<TexCoords left="0" right="0.06640625" top="0.65625" bottom="0.6"/>
						</Texture>
					</Layer>
				</Layers>
			</Frame>
			<Frame parentKey="Icon" inherits="HFFAchievementIconFrameTemplate">
				<Size x="60" y="60"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="8" y="-9"/>
				</Anchors>
			</Frame>
			<!-- Bouclier des points et date d'obtention. -->
			<Button parentKey="Shield">
				<Size x="64" y="64"/>
				<Anchors>
					<Anchor point="TOPRIGHT" x="-6" y="0"/>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture parentKey="Icon" file="Interface\AchievementFrame\UI-Achievement-Shields">
							<Size x="66" y="64"/>
							<Anchors>
								<Anchor point="TOPRIGHT" x="0" y="-6"/>
							</Anchors>
							<TexCoords left="0" right=".5" top="0" bottom="0.5"/>
						</Texture>
					</Layer>
					<Layer level="OVERLAY">
						<FontString parentKey="Points" inherits="AchievementPointsFont">
							<Size x="42" y="16"/>
							<Anchors>
								<Anchor point="TOPRIGHT" x="-13" y="-26"/>
							</Anchors>
						</FontString>
						<FontString parentKey="DateCompleted" inherits="AchievementDateFont" hidden="true" justifyH="CENTER">
							<Size x="100" y="14"/>
							<Anchors>
								<Anchor point="TOP" relativePoint="BOTTOM" x="-2" y="6"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Button>
		</Frames>
	</EventButton>
</Ui>
