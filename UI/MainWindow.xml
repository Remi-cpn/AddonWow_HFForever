<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!--
		Fenêtre principale des hauts faits.
		Clonée du cadre AchievementFrame (Blizzard_AchievementUI/Mainline/
		Blizzard_AchievementUI.xml, export du client Forever 1.60.1), renommée
		avec le préfixe HFF. Retiré : comparaison, statistiques, guilde, filtre,
		bouton Retour, et la gestion UIPanelWindows de Blizzard (on gère
		nous-mêmes l'affichage, pour ne modifier aucune table de Blizzard sauf
		UISpecialFrames, voir UI/MainWindow.lua).
		Le comportement est dans UI/MainWindow.lua.
	-->

	<!-- Bordure dorée des zones de contenu (clone de AchivementGoldBorderBackdrop). -->
	<Frame name="HFFGoldBorderBackdropTemplate" inherits="TooltipBackdropTemplate" virtual="true">
		<KeyValues>
			<KeyValue key="backdropColorAlpha" value="0" type="number"/>
		</KeyValues>
		<Scripts>
			<OnLoad inherit="append">
				-- Couleur ACHIEVEMENT_GOLD_BORDER_COLOR de Blizzard : 1, 0.675, 0.125
				self:SetBackdropBorderColor(1, 0.675, 0.125);
				self:SetFrameLevel(self:GetFrameLevel() + 1);
			</OnLoad>
		</Scripts>
	</Frame>

